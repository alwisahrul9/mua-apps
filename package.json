    "build": "next build && serwist build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && prisma skills sync || exit 0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@serwist/build": "^9.5.12",
